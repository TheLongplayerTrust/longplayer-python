#!/usr/bin/env python3 

from longplayer import Longplayer, DEFAULT_AUDIO_GAIN
import argparse
import logging


def main(args):
    try:
        longplayer = Longplayer(gain=args.gain)
        longplayer.start()
    except KeyboardInterrupt:
        pass

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Longplayer command-line application")
    parser.add_argument("-v", "--verbose", action="store_true", help="Verbose output")
    parser.add_argument("--gain", type=float, default=DEFAULT_AUDIO_GAIN, help="Output volume gain, in dB")
    args = parser.parse_args()

    if args.verbose:
        logging.basicConfig(level=logging.DEBUG, format="%(message)s")

    main(args)
